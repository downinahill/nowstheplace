# Postgres connection string (Vercel → Storage → Neon creates this for you)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Password for /admin — pick something long
ADMIN_PASSWORD="change-me"
# Any long random string; signs your admin login cookie
SESSION_SECRET="paste-a-long-random-string-here"

# Stripe (Dashboard → Developers → API keys). Use sk_test_ keys first.
STRIPE_SECRET_KEY="sk_test_..."
# Stripe (Developers → Webhooks → your endpoint → Signing secret)
STRIPE_WEBHOOK_SECRET="whsec_..."

# Your live address, no trailing slash
NEXT_PUBLIC_SITE_URL="https://nowstheplace.com"

# Created automatically when you add Vercel Blob storage (for uploading new art)
BLOB_READ_WRITE_TOKEN=""
